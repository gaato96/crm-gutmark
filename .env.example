# Supabase / PostgreSQL
# Project Settings → Database → Connection string en el dashboard de Supabase.

# Pooler de transacciones (puerto 6543) — la usa la app en runtime (serverless-friendly).
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa (puerto 5432) — solo para aplicar el esquema/migraciones.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-xxxx.pooler.supabase.com:5432/postgres"

# Email (Resend). Sin esto no salen los links de "Olvidé mi contraseña" ni el
# resumen semanal (el superadmin igual puede generar el link desde /admin).
# RESEND_API_KEY=""
# EMAIL_FROM="Vuelvo <hola@tudominio.com>"   # dominio verificado en Resend

# URL pública de la app para los links de los emails. Si falta, se toma del
# request (o de VERCEL_PROJECT_PRODUCTION_URL en el cron).
# APP_URL="https://vuelvo.app"

# Secreto del cron del resumen semanal (vercel.json). Vercel lo manda solo como
# "Authorization: Bearer <CRON_SECRET>" si la variable existe en el proyecto.
# CRON_SECRET=""
